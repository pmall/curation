POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=database
POSTGRES_USER=username
POSTGRES_PASSWORD=password

# The address Unpaywall asks for to answer a request (curation-fetch).
# Left out: Unpaywall is not asked, and the other sources are used.
UNPAYWALL_EMAIL=you@example.org

# The NCBI API key (curation-genbank), from an NCBI account: 10 requests per second instead
# of 3, a limit shared by the curator agents running at once.
# Left out: the requests are spaced for 3 per second.
NCBI_API_KEY=
